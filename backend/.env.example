# Copy to .env and fill in. Never commit .env.

# LLM: any `provider:model` supported by langchain's init_chat_model.
LLM_MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=
# For OpenAI: `uv sync --extra openai`, LLM_MODEL=openai:gpt-4.1-mini, and set OPENAI_API_KEY.
# OPENAI_API_KEY=

DATABASE_URL=sqlite:///./invoiceiq.db
SEED_SAMPLE_DATA=true
CORS_ORIGINS=http://localhost:3000
